#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
source "$ROOT_DIR/scripts/supabase-runtime-env"

if [[ "${CI:-}" != "true" ]] && ! npx --no-install supabase status >/dev/null 2>&1; then
  printf 'Local Supabase is not running. Start it with npm run services:start.\n' >&2
  exit 1
fi

if ! find supabase/tests -type f -name '*.sql' -print -quit 2>/dev/null | grep -q .; then
  printf 'No database test files were found under supabase/tests.\n' >&2
  exit 1
fi

DB_TEST_OUTPUT="$(mktemp)"
cleanup() {
  rm -f -- "$DB_TEST_OUTPUT"
}
trap cleanup EXIT

if npx --no-install supabase test db --local 2>&1 | tee "$DB_TEST_OUTPUT"; then
  exit 0
fi

if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
  DETAILS="$(tail -c 60000 "$DB_TEST_OUTPUT")"
  DETAILS="${DETAILS//'%'/'%25'}"
  DETAILS="${DETAILS//$'\r'/'%0D'}"
  DETAILS="${DETAILS//$'\n'/'%0A'}"
  printf '::error title=Database and RLS test failure::%s\n' "$DETAILS"
fi

exit 1
