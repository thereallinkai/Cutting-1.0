#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ ! -x node_modules/.bin/next || ! -f .env.local ]]; then
  printf 'The local environment is incomplete; running the idempotent bootstrap first.\n'
  ./scripts/bootstrap
fi

./scripts/services-start

printf 'Starting Cutting Plan at http://localhost:%s\n' "${PORT:-3000}"
printf 'Supabase Studio and captured-email URLs are listed by npm run bootstrap and npm run doctor.\n'

exec ./node_modules/.bin/next dev \
  --hostname "${HOSTNAME:-0.0.0.0}" \
  --port "${PORT:-3000}" \
  "$@"
