#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
source "$ROOT_DIR/scripts/supabase-runtime-env"

if [[ ! -x node_modules/.bin/supabase ]] || ! command -v npx >/dev/null 2>&1; then
  printf 'The project-local Supabase CLI is not installed; there are no project services to stop.\n'
  exit 0
fi

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  printf 'Docker is not available, so no running local Supabase stack can be reached.\n'
  exit 0
fi

if ! npx --no-install supabase status >/dev/null 2>&1; then
  printf 'Local Supabase is already stopped.\n'
  exit 0
fi

printf 'Stopping local Supabase while preserving its development data...\n'
npx --no-install supabase stop
printf 'Local Supabase stopped. No development database reset was performed.\n'
